#!/bin/sh
# ocs — friendly command-line interface for managing this ocserv container.
#
# Usage:  ocs <command> [args]      (run inside the container)
# From the host, e.g.:  docker exec -it ocserv ocs user add alice
# Tip (host alias):      alias ocs='docker exec -it ocserv ocs'
#
# Thin, well-validated wrapper around the tools already in the image
# (occtl, ocpasswd, certtool/openssl) and the existing scripts
# (get-cert.sh, make-client.sh), with clear errors and discoverable help.
set -eu

# --- paths (container-fixed; overridable for testing) ---
SCRIPTS_DIR="${SCRIPTS_DIR:-/scripts}"
OCSERV_DIR="${OCSERV_DIR:-/etc/ocserv}"
AUTH_DIR="${AUTH_DIR:-$OCSERV_DIR/auth}"
PASSWD="${OCPASSWD_FILE:-$AUTH_DIR/passwd}"
CLIENTS_DIR="$AUTH_DIR/clients"
SERVER_CERT="${SERVER_CERT:-$OCSERV_DIR/cert/server-cert.pem}"

PROG="ocs"
VERSION="1.1.0"

# --- pretty output (colors only on a TTY) ---
if [ -t 1 ]; then
  C_RED="$(printf '\033[31m')"; C_GRN="$(printf '\033[32m')"
  C_YEL="$(printf '\033[33m')"; C_DIM="$(printf '\033[2m')"; C_RST="$(printf '\033[0m')"
else
  C_RED=""; C_GRN=""; C_YEL=""; C_DIM=""; C_RST=""
fi
ok()   { printf '%s[OK]%s %s\n'   "$C_GRN" "$C_RST" "$*"; }
info() { printf '%s[..]%s %s\n'   "$C_DIM" "$C_RST" "$*"; }
warn() { printf '%s[!!]%s %s\n'   "$C_YEL" "$C_RST" "$*" >&2; }
die()  { printf '%s[ERR]%s %s\n'  "$C_RED" "$C_RST" "$*" >&2; exit 1; }

# --- helpers ---
need_arg() { [ -n "${1:-}" ] || die "$2"; }

valid_name() {
  # letters, digits, dot, underscore, hyphen; not empty, and not starting
  # with "-" (would read as an option). Client certificate names are also
  # checked by make-client.sh (no leading "." there: they become file names).
  case "$1" in
    ""|-*)             return 1 ;;
    *[!A-Za-z0-9._-]*) return 1 ;;
    *)                 return 0 ;;
  esac
}

require_name() {
  need_arg "${1:-}" "$2"
  valid_name "$1" || die "invalid name '$1' (allowed: letters, digits, . _ -; not starting with -)"
}

user_exists() {
  # fixed string, whole line: "a.b" must not match "axb"
  [ -f "$PASSWD" ] && cut -d: -f1 "$PASSWD" | grep -qxF -- "$1"
}

require_tty() {
  [ -t 0 ] || die "this command needs an interactive terminal — run it as: docker exec -it ocserv $PROG $1"
}

# ============================ commands ============================

cmd_user() {
  sub="${1:-}"; shift 2>/dev/null || true
  case "$sub" in
    list|ls)
      if [ ! -s "$PASSWD" ]; then echo "No users."; return 0; fi
      n=0
      cut -d: -f1 "$PASSWD" | sort | while IFS= read -r u; do
        [ -n "$u" ] && printf '  %s\n' "$u"
      done
      n=$(grep -c '' "$PASSWD" 2>/dev/null || echo 0)
      printf '%s%d user(s)%s\n' "$C_DIM" "$n" "$C_RST"
      ;;
    add|create)
      name="${1:-}"; require_name "$name" "usage: $PROG user add <name>"
      user_exists "$name" && die "user '$name' already exists — use '$PROG user passwd $name' to change the password"
      require_tty "user add <name>"
      mkdir -p "$AUTH_DIR"
      info "creating user '$name' (you will be prompted for a password)"
      if ocpasswd -c "$PASSWD" "$name"; then ok "user '$name' created"; else die "failed to create user '$name'"; fi
      ;;
    passwd|password)
      name="${1:-}"; require_name "$name" "usage: $PROG user passwd <name>"
      user_exists "$name" || die "no such user '$name' — see '$PROG user list'"
      require_tty "user passwd <name>"
      info "changing password for '$name'"
      if ocpasswd -c "$PASSWD" "$name"; then ok "password updated for '$name'"; else die "failed to update password for '$name'"; fi
      ;;
    del|delete|rm|remove)
      name="${1:-}"; require_name "$name" "usage: $PROG user del <name>"
      user_exists "$name" || die "no such user '$name' — see '$PROG user list'"
      if ocpasswd -c "$PASSWD" -d "$name"; then ok "user '$name' deleted"; else die "failed to delete user '$name'"; fi
      ;;
    ""|help|-h|--help)
      cat <<EOF
$PROG user — manage password-auth VPN users

  $PROG user list                list all users
  $PROG user add <name>          create a user (prompts for password)
  $PROG user passwd <name>       change a user's password
  $PROG user del <name>          delete a user
EOF
      ;;
    *) die "unknown subcommand 'user $sub' — try '$PROG user help'" ;;
  esac
}

# --- client certificates ---
CERT_DIR="${CERT_DIR:-$OCSERV_DIR/cert}"
CRL_FILE="$CERT_DIR/crl.pem"
REVOKED_DIR="$CERT_DIR/revoked"
CONF_FILE="${CONF_FILE:-$OCSERV_DIR/config/ocserv.conf}"

# One client certificate operation at a time (shared with make-client.sh
# and crl.sh, which skip their own lock when OCS_LOCK_HELD is set).
client_lock() {
  mkdir -p "$CLIENTS_DIR"
  exec 9>"$CLIENTS_DIR/.lock"
  i=0
  until flock -n 9; do
    i=$((i + 1)); [ "$i" -lt 30 ] || die "another client certificate operation is running; try again"
    sleep 1
  done
  OCS_LOCK_HELD=1; export OCS_LOCK_HELD
}

cert_serial() { openssl x509 -in "$1" -noout -serial 2>/dev/null | sed 's/^serial=//'; }
cert_end() {
  # notAfter as YYYY-MM-DD
  openssl x509 -in "$1" -noout -enddate 2>/dev/null | sed 's/^notAfter=//' | awk '{
    m = index("JanFebMarAprMayJunJulAugSepOctNovDec", $1); printf "%s-%02d-%02d", $4, (m + 2) / 3, $2 }'
}

# The crl file of ocserv.conf (default virtual host), empty if there is none.
conf_crl() {
  [ -f "$CONF_FILE" ] || return 0
  awk '
    /^[ \t]*\[/ { exit }
    /^[ \t]*crl[ \t]*=/ { v = $0; sub(/^[^=]*=[ \t]*/, "", v); sub(/[ \t\r]+$/, "", v)
                          if (v ~ /^".*"$/) v = substr(v, 2, length(v) - 2); print v; exit }
  ' "$CONF_FILE"
}
warn_if_not_enforced() {
  [ "$(conf_crl)" = "$CRL_FILE" ] && return 0
  warn "revocation is NOT enforced: ocserv.conf has no 'crl = $CRL_FILE' line;"
  warn "add it to $CONF_FILE and restart the container."
}

# Parse "<name> [--p12] [--days N]" into name, p12 and CLIENT_CERT_DAYS.
client_args() {
  usage_line="$1"; shift
  name=""; p12=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --p12)  p12="export" ;;
      --days) [ $# -ge 2 ] || die "--days needs a number — usage: $usage_line"
              CLIENT_CERT_DAYS="$2"; export CLIENT_CERT_DAYS; shift ;;
      -*)     die "unknown flag '$1' — usage: $usage_line" ;;
      *)      [ -z "$name" ] && name="$1" || die "unexpected argument '$1'" ;;
    esac
    shift
  done
  require_name "$name" "usage: $usage_line"
}

make_client() {
  [ -x "$SCRIPTS_DIR/make-client.sh" ] || die "missing $SCRIPTS_DIR/make-client.sh"
  sh "$SCRIPTS_DIR/make-client.sh" "$1" $2 || die "could not issue a certificate for '$1'"
}
crl() { sh "$SCRIPTS_DIR/crl.sh" "$@"; }

cmd_client() {
  sub="${1:-}"; shift 2>/dev/null || true
  case "$sub" in
    list|ls)
      printf '%-24s %-10s %-14s %s\n' NAME EXPIRES SERIAL STATUS
      for f in "$CLIENTS_DIR"/*-cert.pem; do
        [ -f "$f" ] || continue
        n="$(basename "$f" -cert.pem)"; serial="$(cert_serial "$f")"
        if [ -f "$REVOKED_DIR/$serial.pem" ]; then st="revoked"
        elif ! openssl x509 -in "$f" -noout -checkend 0 >/dev/null 2>&1; then st="expired"
        else st="valid"; fi
        if [ "$serial" = 01 ]; then st="$st, old serial 01"; fi
        printf '%-24s %-10s %-14s %s\n' "$n" "$(cert_end "$f")" "$(echo "$serial" | cut -c1-12)" "$st"
      done
      for f in "$REVOKED_DIR"/*.pem; do
        [ -f "$f" ] || continue
        serial="$(cert_serial "$f")"
        if [ "$serial" = 01 ]; then continue; fi   # shown on each client with serial 01
        n="$(openssl x509 -in "$f" -noout -subject -nameopt multiline 2>/dev/null | sed -n 's/^ *commonName *= *//p')"
        printf '%-24s %-10s %-14s %s\n' "$n" "$(cert_end "$f")" "$(echo "$serial" | cut -c1-12)" "revoked"
      done
      ;;
    issue|new|create)
      client_args "$PROG client issue <name> [--p12] [--days N]" "$@"
      client_lock
      if [ -f "$CLIENTS_DIR/$name-cert.pem" ]; then
        die "'$name' already has a certificate — '$PROG client renew $name' replaces it and revokes the old one"
      fi
      info "issuing client certificate for '$name'"
      make_client "$name" "$p12"
      ok "client files are in $CLIENTS_DIR/"
      ;;
    renew)
      client_args "$PROG client renew <name> [--p12] [--days N]" "$@"
      client_lock
      cert="$CLIENTS_DIR/$name-cert.pem"
      [ -f "$cert" ] || die "'$name' has no certificate — use '$PROG client issue $name'"
      serial="$(cert_serial "$cert")"
      staged=""
      if [ "$serial" != 01 ]; then
        # Keep the old certificate (hidden: not in the list yet) before it is
        # replaced, so that a failure later on can be finished by crl-update.
        staged="$REVOKED_DIR/.renew-$serial.pem"
        trap 'rm -f "$staged"' EXIT
        { (umask 077; mkdir -p "$REVOKED_DIR") && openssl x509 -in "$cert" -out "$staged"; } \
          || die "cannot keep a copy of the previous certificate in $REVOKED_DIR"
      fi
      info "issuing a new certificate for '$name'"
      make_client "$name" "$p12"
      if [ -z "$staged" ]; then
        warn "the previous certificate has the old shared serial 01 and stays valid;"
        warn "when every such client is renewed, block them all with '$PROG client revoke-legacy'."
      else
        mv -f "$staged" "$REVOKED_DIR/$serial.pem" \
          || die "the new certificate is issued, but the previous one is NOT revoked: its copy is $staged"
        staged=""
        crl update || die "the new certificate is issued and the previous one is recorded as revoked, but the list is not rebuilt — run '$PROG client crl-update'"
      fi
      warn_if_not_enforced
      ok "'$name' has a new certificate; active sessions stay connected"
      ;;
    revoke)
      [ $# -le 1 ] || die "usage: $PROG client revoke <name>"
      name="${1:-}"; require_name "$name" "usage: $PROG client revoke <name>"
      client_lock
      cert="$CLIENTS_DIR/$name-cert.pem"
      [ -f "$cert" ] || die "'$name' has no certificate — see '$PROG client list'"
      if [ "$(cert_serial "$cert")" = 01 ]; then
        die "'$name' has the old shared serial 01 and cannot be revoked alone: renew it ('$PROG client renew $name'), then block every serial 01 certificate with '$PROG client revoke-legacy'"
      fi
      crl add "$cert" || die "could not revoke '$name'"
      # A session cookie lets a client back in without its certificate. occtl
      # also fails when there is nothing to close, so check what is left.
      if occtl show status >/dev/null 2>&1 && ! occtl terminate user "$name" >/dev/null 2>&1 &&
         occtl show users 2>/dev/null | awk 'NR > 1 { print $2 }' | grep -qxF -- "$name"; then
        die "'$name' is revoked, but its sessions could not be closed — run '$PROG client revoke $name' again"
      fi
      rm -f "$CLIENTS_DIR/$name-key.pem" "$CLIENTS_DIR/$name.p12" "$cert"
      warn_if_not_enforced
      ok "'$name' is revoked, its sessions are closed and its key is deleted"
      ;;
    revoke-legacy)
      force=""
      case "$#:${1:-}" in
        0:) ;;
        1:--force) force=1 ;;
        *) die "usage: $PROG client revoke-legacy [--force]" ;;
      esac
      client_lock
      left=""
      for f in "$CLIENTS_DIR"/*-cert.pem; do
        if [ -f "$f" ] && [ "$(cert_serial "$f")" = 01 ]; then left="$left $(basename "$f" -cert.pem)"; fi
      done
      if [ -n "$left" ] && [ -z "$force" ]; then
        die "these clients still have serial 01 and would be blocked:$left — renew them first, or add --force"
      fi
      crl legacy || die "could not revoke serial 01"
      for n in $left; do
        occtl terminate user "$n" >/dev/null 2>&1 || true
        rm -f "$CLIENTS_DIR/$n-key.pem" "$CLIENTS_DIR/$n.p12" "$CLIENTS_DIR/$n-cert.pem"
      done
      warn_if_not_enforced
      [ -z "$left" ] || info "removed the keys and certificates of:$left"
      ok "every certificate with serial 01 is revoked; restart the container to also close their active sessions"
      ;;
    crl-update)
      client_lock
      crl update || die "could not rebuild the revocation list"
      warn_if_not_enforced
      ;;
    ""|help|-h|--help)
      cat <<EOF
$PROG client — client certificates (certificate auth)

  $PROG client list                  certificates: expiry, serial, status
  $PROG client issue <name>          create a client key + certificate
      [--p12]                        also export a .p12 bundle (for import on devices)
      [--days N]                     valid for N days (default: CLIENT_CERT_DAYS or 3650)
  $PROG client renew <name>          new key + certificate; the old one is revoked
      [--p12] [--days N]             (active sessions stay connected)
  $PROG client revoke <name>         revoke, close the user's sessions, delete the key
  $PROG client revoke-legacy         revoke every certificate with the old shared
      [--force]                      serial 01 (issued before random serial numbers)
  $PROG client crl-update            rebuild the revocation list (crl.pem)
EOF
      ;;
    *) die "unknown subcommand 'client $sub' — try '$PROG client help'" ;;
  esac
}

cmd_cert() {
  sub="${1:-}"; shift 2>/dev/null || true
  case "$sub" in
    issue|renew|get)
      mode="${1:-}"
      case "$mode" in
        http|dns) ;;
        "") die "usage: $PROG cert issue <http|dns>" ;;
        *)  die "unknown mode '$mode' — expected 'http' or 'dns'" ;;
      esac
      [ -x "$SCRIPTS_DIR/get-cert.sh" ] || die "missing $SCRIPTS_DIR/get-cert.sh"
      sh "$SCRIPTS_DIR/get-cert.sh" "$mode"
      ;;
    info|status|show)
      [ -f "$SERVER_CERT" ] || die "server certificate not found: $SERVER_CERT"
      command -v openssl >/dev/null 2>&1 || die "openssl not available"
      subject="$(openssl x509 -in "$SERVER_CERT" -noout -subject 2>/dev/null | sed 's/^subject= *//')"
      issuer="$(openssl x509 -in "$SERVER_CERT" -noout -issuer 2>/dev/null | sed 's/^issuer= *//')"
      enddate="$(openssl x509 -in "$SERVER_CERT" -noout -enddate 2>/dev/null | sed 's/^notAfter=//')"
      printf 'Subject : %s\n' "$subject"
      printf 'Issuer  : %s\n' "$issuer"
      printf 'Expires : %s\n' "$enddate"
      if   ! openssl x509 -in "$SERVER_CERT" -noout -checkend 0 >/dev/null 2>&1; then
        die "certificate has EXPIRED — renew with '$PROG cert issue <http|dns>'"
      elif ! openssl x509 -in "$SERVER_CERT" -noout -checkend $((14*86400)) >/dev/null 2>&1; then
        warn "certificate expires within 14 days — renew soon"
      elif ! openssl x509 -in "$SERVER_CERT" -noout -checkend $((30*86400)) >/dev/null 2>&1; then
        info "certificate is within the 30-day renewal window"
      else
        ok "certificate is valid"
      fi
      ;;
    ""|help|-h|--help)
      cat <<EOF
$PROG cert — server (Let's Encrypt) certificate

  $PROG cert issue <http|dns>    issue/renew via acme.sh (HTTP-01 or DNS-01)
  $PROG cert info                show subject, issuer, expiry and validity status
EOF
      ;;
    *) die "unknown subcommand 'cert $sub' — try '$PROG cert help'" ;;
  esac
}

cmd_session() {
  sub="${1:-}"; shift 2>/dev/null || true
  case "$sub" in
    list|ls)
      occtl show users
      ;;
    kill|disconnect|drop)
      name="${1:-}"; require_name "$name" "usage: $PROG session kill <name>"
      info "disconnecting sessions of user '$name'"
      if occtl disconnect user "$name"; then ok "disconnected '$name'"; else die "failed to disconnect '$name' (is the user connected?)"; fi
      ;;
    ""|help|-h|--help)
      cat <<EOF
$PROG session — active VPN sessions

  $PROG session list             list connected users (RX/TX, IP, since)
  $PROG session kill <name>      disconnect all sessions of a user
EOF
      ;;
    *) die "unknown subcommand 'session $sub' — try '$PROG session help'" ;;
  esac
}

cmd_status() { occtl show status; }

cmd_version() {
  printf '%s %s\n' "$PROG" "$VERSION"
  ocserv -v 2>/dev/null | head -n1 || true
}

usage() {
  cat <<EOF
$PROG $VERSION — manage this ocserv container

Usage: $PROG <command> [args]

Commands:
  user      manage password-auth users (list, add, passwd, del)
  client    client certificates (list, issue, renew, revoke)
  cert      issue/renew the server cert and show its status
  session   list active sessions and disconnect users
  status    show server status (uptime, sessions, bans)
  version   show versions
  help      show this help

Run '$PROG <command> help' for command-specific usage.

From the host:  docker exec -it ocserv $PROG <command> [args]
Handy alias:    alias ocs='docker exec -it ocserv ocs'
EOF
}

# ============================ dispatch ============================
cmd="${1:-help}"; shift 2>/dev/null || true
case "$cmd" in
  user)              cmd_user "$@" ;;
  client)            cmd_client "$@" ;;
  cert)              cmd_cert "$@" ;;
  session|sessions)  cmd_session "$@" ;;
  status)            cmd_status ;;
  version|--version|-V) cmd_version ;;
  help|-h|--help|"") usage ;;
  *) die "unknown command '$cmd' — run '$PROG help'" ;;
esac
